<?xml version="1.0" encoding="UTF-8"?>
<!--
  Installer definition for NetBox Local.

  Installs per user into %LOCALAPPDATA%\Programs\NetBox Local. That choice is
  deliberate: emergency notebooks are managed devices whose users rarely hold
  administrator rights, and nothing in this application needs them. No service
  is registered, no system directory is written to, and every port is bound to
  the loopback interface.

  The file list in Files.wxs is generated by heat.exe during the build and is
  not edited by hand.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="NetBox Local"
           Language="1033"
           Version="1.0.0"
           Manufacturer="Gasi-Code"
           UpgradeCode="F54B235D-DA98-4889-A67D-EB8E9E5B2C5C">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             Description="NetBox Local - offline copy of NetBox for emergency notebooks"
             Comments="Contains NetBox, PostgreSQL, Garnet, the .NET runtime and Python." />

    <!-- Replacing an older version keeps the data directory untouched, because
         that lives outside the installation folder. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of NetBox Local is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="2048" />

    <Property Id="ARPPRODUCTICON" Value="NetBoxLocalIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Icon Id="NetBoxLocalIcon" SourceFile="$(var.SourceDir)\assets\netbox-local.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="NetBox Local" />
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppStartMenuFolder" Name="NetBox Local" />
      </Directory>
    </Directory>

    <!-- Shortcuts point at the .cmd rather than the .ps1: a .ps1 started from a
         shortcut closes its window the moment it ends, taking any error message
         with it. -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="6D861948-498C-4C27-91D0-8CA4BDB7458D">
        <Shortcut Id="DesktopShortcutEntry"
                  Name="NetBox Local"
                  Description="Start NetBox Local and load the current dataset"
                  Target="[INSTALLFOLDER]src\launcher\NetBoxLocal.cmd"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="NetBoxLocalIcon" />
        <RemoveFolder Id="RemoveDesktopShortcut" On="uninstall" />
        <!-- A per-user component needs a registry key as its KeyPath; a file
             under HKCU is not permitted. -->
        <RegistryValue Root="HKCU" Key="Software\Gasi-Code\NetBoxLocal"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppStartMenuFolder">
      <Component Id="StartMenuShortcuts" Guid="BA7B4E39-081E-4E8B-92B5-433ECF75E379">
        <Shortcut Id="StartMenuStart"
                  Name="NetBox Local"
                  Description="Start NetBox Local and load the current dataset"
                  Target="[INSTALLFOLDER]src\launcher\NetBoxLocal.cmd"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="NetBoxLocalIcon" />
        <Shortcut Id="StartMenuStop"
                  Name="Stop NetBox Local"
                  Description="Shut NetBox Local down"
                  Target="[INSTALLFOLDER]src\launcher\Stop-NetBoxLocal.cmd"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="StartMenuImport"
                  Name="Import dataset"
                  Description="Load an export into NetBox Local"
                  Target="[INSTALLFOLDER]src\import\Import-NetBoxExport.cmd"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppStartMenuFolder" Directory="AppStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Gasi-Code\NetBoxLocal"
                       Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Uninstalling removes the whole installation tree in one go.
         Without this, MSI would only delete the files it installed and leave
         roughly 3,000 empty directories behind, and its validator (ICE64) would
         demand a RemoveFile entry for every single one of them. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="CleanUpInstallFolder" Guid="9C1D4A72-3E5B-4F80-B2A6-71D0E8C4F913">
        <RegistryValue Root="HKCU" Key="Software\Gasi-Code\NetBoxLocal"
                       Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER_ABSOLUTE" />
      </Component>
    </DirectoryRef>

    <!-- RemoveFolderEx resolves its path at uninstall time from a property that
         has to be restored from the registry first. -->
    <Property Id="INSTALLFOLDER_ABSOLUTE">
      <RegistrySearch Id="FindInstallFolder" Root="HKCU"
                      Key="Software\Gasi-Code\NetBoxLocal" Name="InstallPath" Type="raw" />
    </Property>

    <Feature Id="MainFeature" Title="NetBox Local" Level="1" Absent="disallow">
      <ComponentGroupRef Id="BundleFiles" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="CleanUpInstallFolder" />
    </Feature>

    <!-- Applies the choices from AccessModeDlg to config\NetBoxLocal.json.
         Deferred and impersonated: it must run after the files are on disk, and
         as the installing user, because the configuration it writes belongs to
         that user's profile. -->
    <CustomAction Id="SetApplyOptionsCmd"
                  Property="ApplyInstallOptions"
                  Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]src\launcher\Set-InstallOptions.ps1&quot; -Mode &quot;[ACCESSMODE]&quot; -Username &quot;[NBUSER]&quot; -Password &quot;[NBPASSWORD]&quot; -ReadOnlyUsername &quot;[NBROUSER]&quot; -ReadOnlyPassword &quot;[NBROPASSWORD]&quot; -SyncRoot &quot;[SYNCROOT]&quot; -NetBoxServer &quot;[NBSERVER]&quot; -ApiKey &quot;[NBAPIKEY]&quot; -ScriptPath &quot;[SCRIPTPATH]&quot; -ConfigPath &quot;[INSTALLFOLDER]config\NetBoxLocal.json&quot; -ExportScriptPath &quot;[INSTALLFOLDER]src\export\Sync-NetBoxExport.ps1&quot;" />

    <CustomAction Id="ApplyInstallOptions"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetApplyOptionsCmd" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="ApplyInstallOptions" After="SetApplyOptionsCmd">NOT Installed</Custom>
    </InstallExecuteSequence>

    <!-- The stock WixUI_InstallDir flow with AccessModeDlg spliced in between
         the folder page and the confirmation. -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Without this the licence page shows WiX's Lorem ipsum placeholder.
         It has to be a WixVariable: the -d switch on candle sets a preprocessor
         variable, which the UI never looks at. The path resolves through
         SourceDir so the build works from any checkout location. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\installer\License.rtf" />

    <UI Id="NetBoxLocalUI">
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="AccessModeDlg" Order="10">
        <![CDATA[WIXUI_INSTALLDIR_VALID = "1"]]>
      </Publish>

      <Publish Dialog="AccessModeDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">1</Publish>
      <Publish Dialog="AccessModeDlg" Control="Next" Event="NewDialog" Value="SyncSourceDlg">1</Publish>

      <Publish Dialog="SyncSourceDlg" Control="Back" Event="NewDialog" Value="AccessModeDlg">1</Publish>
      <Publish Dialog="SyncSourceDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SyncSourceDlg" Order="10">
        <![CDATA[NOT Installed]]>
      </Publish>
    </UI>

  </Product>
</Wix>
